{
  "name": "@prism/dsh-host-service",
  "description": "棱镜业务服务的 Host 插件：拉起 prism-service 子进程，通过 JSON-RPC 调用，崩溃后自动重启（ctx.prismService）",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-subprocess": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*"
  }
}
