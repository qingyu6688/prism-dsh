{
  "name": "@prism/dsh-bundle-desktop",
  "description": "棱镜桌面端的组合包：在 dsh-base 和 dsh-web-app 之上去掉开发者功能和遥测，加上棱镜的插件",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./presets/*.patch.yml": "./presets/*.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "presets/*.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/prism.patch.yml"
      ]
    }
  },
  "dependencies": {
    "@prism/dsh-client-ui-brand": "workspace:*",
    "@prism/dsh-host-catalog": "workspace:*",
    "@prism/dsh-host-service": "workspace:*",
    "@prism/dsh-tool-catalog": "workspace:*"
  }
}
